FUNCTION_BLOCK Ghost

VAR_INPUT
	pacman           : REAL;
	distPeligro      : REAL;
	ppill            : REAL;
	distPP           : REAL;
	comestible       : REAL;
	margenBloqueo    : REAL;
	soyMejorBloqueo  : REAL;
	margenCorte      : REAL;
	soyMejorCorte    : REAL;
	margenCierre     : REAL;
	soyMejorCierre   : REAL;
	puestoCercania   : REAL;
	tieneRefugio     : REAL;
	estabaBloqueando : REAL;
END_VAR

VAR_OUTPUT
	perseguir : REAL;
	huir      : REAL;
END_VAR

FUZZIFY pacman
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY distPeligro
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY ppill
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY distPP
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY comestible
	TERM no := (0, 1) (1, 0);
	TERM si := (0, 0) (1, 1) (200, 1);
END_FUZZIFY

FUZZIFY margenBloqueo
	TERM negativo := (-50, 1) (0, 1) (2, 0);
	TERM positivo := (0, 0) (3, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorBloqueo
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY margenCorte
	TERM negativo := (-50, 1) (0, 1) (2, 0);
	TERM positivo := (0, 0) (2, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorCorte
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY margenCierre
	TERM negativo := (-50, 1) (-1, 1) (0, 0);
	TERM positivo := (-1, 0) (0, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorCierre
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY puestoCercania
	TERM primero := (1, 1) (1.5, 0);
	TERM otro    := (1.5, 0) (2, 1) (4, 1);
END_FUZZIFY

FUZZIFY tieneRefugio
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY estabaBloqueando
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

DEFUZZIFY perseguir
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huir
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK reglas
	AND : MIN;
	ACT : MIN;
	ACCU : MAX;

	RULE 1 : IF comestible IS si THEN huir IS mucho;
	RULE 2 : IF comestible IS no THEN perseguir IS mucho;
END_RULEBLOCK

END_FUNCTION_BLOCK