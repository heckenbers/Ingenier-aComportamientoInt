FUNCTION_BLOCK Ghost

VAR_INPUT
	pacman           : REAL;
	distPeligro      : REAL;
	ppill            : REAL;
	distPP           : REAL;
	comestible       : REAL;
	margenBloqueo    : REAL;
	soyMejorBloqueo  : REAL;
	margenCorte      : REAL;
	soyMejorCorte    : REAL;
	margenCierre     : REAL;
	soyMejorCierre   : REAL;
	puestoCercania   : REAL;
	tieneRefugio     : REAL;
	estabaBloqueando : REAL;
END_VAR

VAR_OUTPUT
	perseguir      : REAL;
	huidaEficiente : REAL;
	refugiarse     : REAL;
	dispersarse    : REAL;
	huirDePP       : REAL;
	bloquearPP     : REAL;
END_VAR

FUZZIFY pacman
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY distPeligro
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY ppill
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY distPP
	TERM cerca := (0, 1) (20, 1) (45, 0);
	TERM media := trian 30 55 80;
	TERM lejos := (65, 0) (90, 1) (150, 1);
END_FUZZIFY

FUZZIFY comestible
	TERM no    := (0, 1) (1, 0);
	TERM si    := (0, 0) (1, 1) (200, 1);
	TERM poco  := (0, 0) (1, 1) (20, 1) (45, 0);
	TERM mucho := (25, 0) (50, 1) (200, 1);
END_FUZZIFY

FUZZIFY margenBloqueo
	TERM negativo := (-50, 1) (0, 1) (2, 0);
	TERM positivo := (0, 0) (3, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorBloqueo
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY margenCorte
	TERM negativo := (-50, 1) (0, 1) (2, 0);
	TERM positivo := (0, 0) (2, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorCorte
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY margenCierre
	TERM negativo := (-50, 1) (-1, 1) (0, 0);
	TERM positivo := (-1, 0) (0, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorCierre
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY puestoCercania
	TERM primero := (1, 1) (1.5, 0);
	TERM otro    := (1.5, 0) (2, 1) (4, 1);
END_FUZZIFY

FUZZIFY tieneRefugio
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY estabaBloqueando
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

DEFUZZIFY perseguir
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huidaEficiente
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY refugiarse
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY dispersarse
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huirDePP
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY bloquearPP
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK reglas
	AND : MIN;
	ACT : MIN;
	ACCU : MAX;

	// ---- CAZA BASE ------------------------------------------------
	RULE 1 : IF comestible IS no THEN perseguir IS mucho;

	// ---- SUPERVIVENCIA (siendo comestible) ------------------------------------------
	// R2: por defecto al ser comestible, huida eficiente
	RULE 2 : IF comestible IS si THEN huidaEficiente IS mucho;

	// R3: si tengo un compañero seguro cerca y Ms. Pac-Man viene hacia mí, refugiarme en él
	RULE 3 : IF comestible IS si AND tieneRefugio IS si AND distPeligro IS cerca THEN refugiarse IS mucho, huidaEficiente IS poco;

	// R4: si Ms. Pac-Man está lejos y queda bastante tiempo de comestible, repartirse las esquinas
	RULE 4 : IF comestible IS mucho AND distPeligro IS lejos THEN dispersarse IS mucho, huidaEficiente IS poco;

	// ---- PELIGRO POR POWER PILL (no comestible) -----------------------------------
	// R5-R6: soy el mejor situado y llego antes a la PP amenazada -> bloquearla (baja perseguir y huirDePP)
	RULE 5 : IF comestible IS no AND ppill IS cerca AND margenBloqueo IS positivo AND soyMejorBloqueo IS si THEN bloquearPP IS mucho, perseguir IS poco;
	RULE 6 : IF comestible IS no AND ppill IS cerca AND margenBloqueo IS positivo AND soyMejorBloqueo IS si THEN huirDePP IS poco;

	// R7-R8: histéresis -> si ya estaba bloqueando y sigo llegando antes, mantengo el bloqueo
	RULE 7 : IF comestible IS no AND estabaBloqueando IS si AND ppill IS cerca AND margenBloqueo IS positivo THEN bloquearPP IS mucho, perseguir IS poco;
	RULE 8 : IF comestible IS no AND estabaBloqueando IS si AND ppill IS cerca AND margenBloqueo IS positivo THEN huirDePP IS poco;

	// R9: PP amenazada y estoy cerca de esa PP (no de ella en general), sin ventaja para bloquear -> apartarme
	RULE 9 : IF comestible IS no AND ppill IS cerca AND distPP IS cerca AND (margenBloqueo IS negativo OR soyMejorBloqueo IS no) THEN huirDePP IS mucho, perseguir IS poco;

END_RULEBLOCK

END_FUNCTION_BLOCK