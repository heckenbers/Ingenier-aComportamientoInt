FUNCTION_BLOCK Ghost

VAR_INPUT
	pacman           : REAL;
	distPeligro      : REAL;
	ppill            : REAL;
	distPP           : REAL;
	comestible       : REAL;
	margenBloqueo    : REAL;
	soyMejorBloqueo  : REAL;
	margenCorte      : REAL;
	soyMejorCorte    : REAL;
	margenCierre     : REAL;
	soyMejorCierre   : REAL;
	puestoCercania   : REAL;
	tieneRefugio     : REAL;
	estabaBloqueando : REAL;
END_VAR

VAR_OUTPUT
	perseguir      : REAL;
	huidaEficiente : REAL;
	dispersarse    : REAL;
	huirDePP       : REAL;
	bloquearPP     : REAL;
	cerrarPaso     : REAL;
	interceptar    : REAL;
	cazar          : REAL;
	vigilarPP      : REAL;
END_VAR

FUZZIFY pacman
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY distPeligro
	TERM cerca := (0, 1) (15, 1) (35, 0);
	TERM media := trian 20 45 70;
	TERM lejos := (55, 0) (80, 1) (150, 1);
END_FUZZIFY

FUZZIFY ppill
	TERM cerca := (0, 1) (15, 1) (30, 0);
	TERM media := trian 25 50 75;
	TERM lejos := (60, 0) (85, 1) (150, 1);
END_FUZZIFY

FUZZIFY distPP
	TERM cerca := (0, 1) (20, 1) (45, 0);
	TERM media := trian 30 55 80;
	TERM lejos := (65, 0) (90, 1) (150, 1);
END_FUZZIFY

FUZZIFY comestible
	TERM no    := (0, 1) (1, 0);
	TERM si    := (0, 0) (1, 1) (200, 1);
	TERM poco  := (0, 0) (1, 1) (20, 1) (45, 0);
	TERM mucho := (25, 0) (50, 1) (200, 1);
END_FUZZIFY

FUZZIFY margenBloqueo
	TERM negativo := (-50, 1) (-2, 1) (1, 0);
	TERM positivo := (-2, 0) (1, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorBloqueo
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY margenCorte
	TERM negativo := (-50, 1) (-4, 1) (0, 0);
	TERM positivo := (-4, 0) (0, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorCorte
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY margenCierre
	TERM negativo := (-50, 1) (-5, 1) (-1, 0);
	TERM positivo := (-5, 0) (-1, 1) (50, 1);
END_FUZZIFY

FUZZIFY soyMejorCierre
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY puestoCercania
	TERM primero := (1, 1) (1.5, 0);
	TERM otro    := (1.5, 0) (2, 1) (4, 1);
END_FUZZIFY

FUZZIFY tieneRefugio
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY estabaBloqueando
	TERM no := (0, 1) (0.5, 0);
	TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

DEFUZZIFY perseguir
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huidaEficiente
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY dispersarse
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huirDePP
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY bloquearPP
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY cerrarPaso
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY interceptar
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY cazar
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY vigilarPP
	TERM poco  := (0, 1) (4, 0);
	TERM algo  := trian 2 5 8;
	TERM mucho := (6, 0) (10, 1);
	METHOD : COG;
	DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK reglas
	AND : MIN;
	ACT : MIN;
	ACCU : MAX;

	// ---- CAZA BASE (líder o convergencia a bocajarro) ----------------------------
	RULE 1 : IF comestible IS no THEN perseguir IS mucho;

	// ---- SUPERVIVENCIA SIENDO COMESTIBLE ------------------------------------------
	RULE 2 : IF comestible IS si THEN huidaEficiente IS mucho;
	RULE 3 : IF comestible IS mucho AND distPeligro IS lejos THEN dispersarse IS mucho, huidaEficiente IS poco;

	// ---- BLOQUEO Y PROTECCIÓN DE POWER PILLS --------------------------------------
	// R4-R5: mejor situado para taponar una PP rondada (en media o cerca)
	RULE 4 : IF comestible IS no AND ppill IS NOT lejos AND margenBloqueo IS positivo AND soyMejorBloqueo IS si THEN bloquearPP IS mucho, perseguir IS poco;
	RULE 5 : IF comestible IS no AND ppill IS NOT lejos AND margenBloqueo IS positivo AND soyMejorBloqueo IS si THEN huirDePP IS poco, vigilarPP IS poco;

	// R6: histéresis -> mantener el bloqueo si ya estaba taponando y conserva margen
	RULE 6 : IF comestible IS no AND estabaBloqueando IS si AND ppill IS NOT lejos AND margenBloqueo IS positivo THEN bloquearPP IS mucho, perseguir IS poco;

	// R7: PP encima y no estoy bloqueando -> apartarme anticipando el giro
	RULE 7 : IF comestible IS no AND estabaBloqueando IS no AND ppill IS cerca AND distPP IS cerca AND (margenBloqueo IS negativo OR soyMejorBloqueo IS no) THEN huirDePP IS mucho, perseguir IS poco;

	// ---- CAZA COORDINADA Y ACORRALAMIENTO -----------------------------------------
	// R8-R9: cerrar salida de pasillo (margen ampliado para llegar a tiempo)
	RULE 8 : IF comestible IS no AND ppill IS NOT cerca AND margenCierre IS positivo AND soyMejorCierre IS si THEN cerrarPaso IS mucho, perseguir IS poco;
	RULE 9 : IF comestible IS no AND ppill IS NOT cerca AND margenCierre IS positivo AND soyMejorCierre IS si THEN cazar IS poco;

	// R10-R11: interceptar trayectoria por delante si soy secundario
	RULE 10 : IF comestible IS no AND ppill IS NOT cerca AND puestoCercania IS otro AND margenCorte IS positivo AND soyMejorCorte IS si THEN interceptar IS mucho, perseguir IS poco;
	RULE 11 : IF comestible IS no AND ppill IS NOT cerca AND puestoCercania IS otro AND margenCorte IS positivo AND soyMejorCorte IS si THEN cazar IS poco;

	// R12: cubrir una PP a media distancia si no soy el bloqueador
	RULE 12 : IF comestible IS no AND ppill IS media AND distPP IS cerca AND (margenBloqueo IS negativo OR soyMejorBloqueo IS no) THEN vigilarPP IS mucho, perseguir IS poco;

	// R13: flanqueo permanente de secundarios (media y lejos) para no ir todos juntos
	RULE 13 : IF comestible IS no AND ppill IS NOT cerca AND puestoCercania IS otro AND pacman IS NOT cerca THEN cazar IS mucho, perseguir IS poco;

END_RULEBLOCK

END_FUNCTION_BLOCK