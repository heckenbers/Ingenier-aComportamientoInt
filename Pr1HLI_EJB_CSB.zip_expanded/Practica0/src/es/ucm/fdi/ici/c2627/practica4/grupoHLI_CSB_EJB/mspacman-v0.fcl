// Ms. Pac-Man · v0: recolectar, evadir, escapar y cazar. Lo que decidía la raíz de la HFSM
// de la V3 (P2), pero borroso. cebo, espera y quedan se reciben, pero todavía no se usan.

FUNCTION_BLOCK MsPacMan

VAR_INPUT
   amenaza : REAL;    // ticks hasta que el peligroso más rápido llega a ella, 0..60
   margen : REAL;     // ventaja de la mejor ruta de huida, en ticks, -10..40
   caza : REAL;       // fantasmas comestibles que le da tiempo a encadenar, 0..4
   revertir : REAL;   // ticks hasta que un comestible vuelva a ser peligroso donde está, 0..60
   cebo : REAL;       // fantasmas que encadenaría comiéndose ahora la píldora de cebo, 0..4
   espera : REAL;     // ticks seguidos esperando junto al cebo, 0..120
   quedan : REAL;     // píldoras que quedan, % del laberinto, 0..100
   pildora : REAL;    // pasos hasta la píldora más cercana, 0..100 (la manda el Input desde la v6;
                      // aquí sólo se declara, sin reglas, para que no falle con No such variable)
END_VAR

VAR_OUTPUT            // una por acción, con su getActionId(), de 0 a 10
   escapar : REAL;
   evadir : REAL;
   cazar : REAL;
   recolectar : REAL;
END_VAR

FUZZIFY amenaza
   TERM inminente := (0, 1) (4, 1) (8, 0);
   TERM cerca := trian 5 11 18;
   TERM lejos := (13, 0) (22, 1) (60, 1);
END_FUZZIFY

FUZZIFY margen       // en la V3, una ruta es segura con más de 4 ticks de ventaja
   TERM nulo := (-10, 1) (3, 1) (7, 0);
   TERM justo := trian 4 10 18;
   TERM holgado := (12, 0) (20, 1) (40, 1);
END_FUZZIFY

FUZZIFY caza
   TERM ninguno := (0, 1) (0.6, 0);
   TERM alguno := (0.4, 0) (1, 1) (4, 1);
END_FUZZIFY

FUZZIFY revertir
   TERM pronto := (0, 1) (8, 1) (16, 0);
   TERM tarde := (10, 0) (20, 1) (60, 1);
END_FUZZIFY

FUZZIFY cebo
   TERM nada := (0, 1) (1, 0);
   TERM bueno := (1, 0) (2, 1) (4, 1);
END_FUZZIFY

FUZZIFY espera
   TERM poca := (0, 1) (60, 0);
   TERM mucha := (40, 0) (100, 1) (120, 1);
END_FUZZIFY

FUZZIFY pildora
   TERM cerca := (0, 1) (10, 1) (20, 0);
   TERM lejos := (12, 0) (25, 1) (100, 1);
END_FUZZIFY

FUZZIFY quedan
   TERM pocas := (0, 1) (6, 1) (12, 0);
   TERM muchas := (8, 0) (15, 1) (100, 1);
END_FUZZIFY

DEFUZZIFY escapar
   TERM poco  := (0, 1) (4, 0);
   TERM algo  := trian 2 5 8;
   TERM mucho := (6, 0) (10, 1);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY evadir
   TERM poco  := (0, 1) (4, 0);
   TERM algo  := trian 2 5 8;
   TERM mucho := (6, 0) (10, 1);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY cazar
   TERM poco  := (0, 1) (4, 0);
   TERM algo  := trian 2 5 8;
   TERM mucho := (6, 0) (10, 1);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY recolectar
   TERM poco  := (0, 1) (4, 0);
   TERM algo  := trian 2 5 8;
   TERM mucho := (6, 0) (10, 1);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK reglas
   AND : MIN;
   ACT : MIN;
   ACCU : MAX;

   // (jFuzzyLogic admite como mucho dos consecuencias por regla: si una situación sube una
   //  salida y baja dos, son dos reglas con la misma condición)

   // emergencia: el fantasma ya está encima o no queda ninguna ruta con ventaja
   RULE 1 : IF amenaza IS inminente OR margen IS nulo THEN escapar IS mucho, recolectar IS poco;
   RULE 2 : IF amenaza IS inminente OR margen IS nulo THEN evadir IS algo;
   // un fantasma se acerca pero hay por dónde huir: evadir (sin dejar de comer)
   RULE 3 : IF amenaza IS cerca AND margen IS NOT nulo THEN evadir IS mucho, recolectar IS poco;
   RULE 4 : IF amenaza IS cerca AND margen IS NOT nulo THEN escapar IS poco;
   // nadie cerca: a comer, y cuanto más margen, más
   RULE 5 : IF amenaza IS lejos AND margen IS holgado AND revertir IS tarde THEN recolectar IS mucho, evadir IS poco;
   RULE 6 : IF amenaza IS lejos AND margen IS NOT nulo THEN escapar IS poco;
   RULE 7 : IF amenaza IS lejos AND margen IS justo AND revertir IS tarde THEN recolectar IS algo, evadir IS poco;
   // poder: si hay fantasmas a tiro y no vuelven pronto, cazar; esto pasa por delante de comer
   RULE 8 : IF caza IS alguno AND revertir IS tarde AND amenaza IS NOT inminente THEN cazar IS mucho, recolectar IS poco;
   RULE 9 : IF caza IS ninguno THEN cazar IS poco;
   // un comestible está a punto de volver a ser peligroso a su lado: apartarse
   RULE 10 : IF revertir IS pronto THEN evadir IS mucho, cazar IS poco;
END_RULEBLOCK

END_FUNCTION_BLOCK
